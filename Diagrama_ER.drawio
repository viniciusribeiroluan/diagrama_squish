        <mxCell id="header" value="RELAÇÕES ENTRE AS TABELAS — LOJA DE SQUISH" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1D2939;" vertex="1" parent="1">
