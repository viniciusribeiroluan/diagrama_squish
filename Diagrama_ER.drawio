        </mxCell>
        <mxCell id="subtitle" value="Cada seta sai da tabela referenciada (pai) para a tabela que armazena a FK (filha). As frases descrevem o sentido pai → filha." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#475467;" vertex="1" parent="1">
          <mxGeometry x="45" y="78" width="2990" height="45" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;1:N:&lt;/b&gt; um pai pode ter vários filhos; cada filho referencia um pai. &amp;nbsp; &lt;b&gt;1:N · FK opcional:&lt;/b&gt; o filho pode não ter pai associado. &amp;nbsp; &lt;b&gt;1:1 opcional:&lt;/b&gt; um pedido pode ter zero ou um frete." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#9DB8F2;fontColor=#285A93;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="120" width="3100" height="65" as="geometry" />
        </mxCell>
        <mxCell id="rel_0" value="&lt;b&gt;01. categorias &lt;font color=&quot;#0B6E75&quot;&gt;subdivide-se em&lt;/font&gt; subcategorias&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#9A3412&quot;&gt;&lt;b&gt;1:N&lt;/b&gt;&lt;/font&gt; &amp;nbsp; &lt;font color=&quot;#475467&quot;&gt;FK: subcategorias.categoria_id → categorias.id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#667085&quot;&gt;Cada subcategorias aponta para um categorias; um categorias pode ter vários subcategorias.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
