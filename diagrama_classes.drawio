        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    categorias {\n        int id PK\n        varchar nome\n        text descricao\n        boolean ativo\n    }\n    subcategorias {\n        int id PK\n        int categoria_id FK\n        varchar nome\n        text descricao\n        boolean ativo\n    }\n    marcas {\n        int id PK\n        varchar nome\n        varchar pais_origem\n        varchar site_oficial\n        boolean ativo\n    }\n    fornecedores {\n        int id PK\n        varchar razao_social\n        varchar nome_fantasia\n        char cnpj\n        varchar email\n        varchar telefone\n        boolean ativo\n    }\n    colecoes {\n        int id PK\n        varchar nome\n        varchar tema\n        date data_inicio\n        date data_fim\n        boolean ativo\n    }\n    produtos {\n        int id PK\n        int subcategoria_id FK\n        int marca_id FK\n        int colecao_id FK\n        varchar nome\n        text descricao\n        varchar material\n        tinyint idade_minima\n        boolean ativo\n        datetime criado_em\n    }\n    variantes_produto {\n        int id PK\n        int produto_id FK\n        varchar sku\n        varchar codigo_barras\n        decimal preco\n        decimal peso_gramas\n        decimal altura_cm\n        decimal largura_cm\n        decimal profundidade_cm\n        boolean ativo\n    }\n    imagens_produto {\n        int id PK\n        int produto_id FK\n        int variante_id FK\n        varchar url_imagem\n        varchar texto_alternativo\n        boolean imagem_principal\n        int ordem_exibicao\n    }\n    atributos {\n        int id PK\n        varchar nome\n        varchar descricao\n    }\n    valores_atributo {\n        int id PK\n        int atributo_id FK\n        varchar valor\n    }\n    variante_atributos {\n        int id PK\n        int variante_id FK\n        int valor_atributo_id FK\n    }\n    etiquetas {\n        int id PK\n        varchar nome\n        varchar descricao\n    }\n    produto_etiquetas {\n        int id PK\n        int produto_id FK\n        int etiqueta_id FK\n    }\n    avaliacoes_produto {\n        int id PK\n        int produto_id FK\n        int cliente_id FK\n        tinyint nota\n        varchar titulo\n        text comentario\n        boolean publicada\n        datetime criada_em\n    }\n    clientes {\n        int id PK\n        varchar nome\n        varchar email\n        char cpf\n        varchar telefone\n        varchar senha_hash\n        datetime cadastrado_em\n        boolean ativo\n    }\n    enderecos_cliente {\n        int id PK\n        int cliente_id FK\n        varchar apelido\n        varchar destinatario\n        char cep\n        varchar logradouro\n        varchar numero\n        varchar complemento\n        varchar bairro\n        varchar cidade\n        char uf\n        boolean principal\n    }\n    funcionarios {\n        int id PK\n        varchar nome\n        varchar email\n        varchar cargo\n        date data_admissao\n        boolean ativo\n    }\n    perfis_acesso {\n        int id PK\n        varchar nome\n        varchar descricao\n    }\n    funcionario_perfis {\n        int id PK\n        int funcionario_id FK\n        int perfil_id FK\n    }\n    armazens {\n        int id PK\n        varchar codigo\n        varchar nome\n        varchar logradouro\n        varchar cidade\n        char uf\n        boolean ativo\n    }\n    localizacoes_estoque {\n        int id PK\n        int armazem_id FK\n        varchar corredor\n        varchar prateleira\n        varchar posicao\n    }\n    estoques {\n        int id PK\n        int variante_id FK\n        int localizacao_id FK\n        int quantidade_disponivel\n        int quantidade_reservada\n        datetime atualizado_em\n    }\n    lotes_estoque {\n        int id PK\n        int variante_id FK\n        varchar codigo_lote\n        date fabricado_em\n        date validade\n        int quantidade_inicial\n    }\n    movimentos_estoque {\n        int id PK\n        int estoque_id FK\n        int lote_id FK\n        int funcionario_id FK\n        varchar tipo_movimento\n        int quantidade\n        varchar motivo\n        datetime registrado_em\n    }\n    entradas_estoque {\n        int id PK\n        int fornecedor_id FK\n        int armazem_id FK\n        int funcionario_id FK\n        varchar numero_documento\n        datetime data_entrada\n        varchar status\n    }\n    itens_entrada_estoque {\n        int id PK\n        int entrada_id FK\n        int variante_id FK\n        int lote_id FK\n        int quantidade\n        decimal custo_unitario\n    }\n    carrinhos {\n        int id PK\n        int cliente_id FK\n        varchar status\n        datetime criado_em\n        datetime atualizado_em\n    }\n    itens_carrinho {\n        int id PK\n        int carrinho_id FK\n        int variante_id FK\n        int quantidade\n        decimal preco_referencia\n    }\n    pedidos {\n        int id PK\n        int cliente_id FK\n        int endereco_entrega_id FK\n        varchar numero_pedido\n        varchar status\n        decimal subtotal\n        decimal desconto_total\n        decimal frete_total\n        decimal valor_total\n        text observacoes\n        datetime criado_em\n    }\n    itens_pedido {\n        int id PK\n        int pedido_id FK\n        int variante_id FK\n        varchar nome_item\n        varchar sku_item\n        int quantidade\n        decimal preco_unitario\n        decimal desconto_unitario\n    }\n    historico_status_pedido {\n        int id PK\n        int pedido_id FK\n        int funcionario_id FK\n        varchar status_anterior\n        varchar status_novo\n        varchar observacao\n        datetime alterado_em\n    }\n    cupons {\n        int id PK\n        varchar codigo\n        varchar descricao\n        varchar tipo_desconto\n        decimal valor_desconto\n        decimal pedido_minimo\n        datetime inicio_em\n        datetime fim_em\n        int limite_usos\n        boolean ativo\n    }\n    pedido_cupons {\n        int id PK\n        int pedido_id FK\n        int cupom_id FK\n        decimal desconto_aplicado\n    }\n    pagamentos {\n        int id PK\n        int pedido_id FK\n        varchar metodo\n        varchar status\n        decimal valor\n        varchar referencia_gateway\n        datetime criado_em\n        datetime confirmado_em\n    }\n    transacoes_pagamento {\n        int id PK\n        int pagamento_id FK\n        varchar tipo\n        varchar status\n        varchar codigo_gateway\n        decimal valor\n        datetime processado_em\n    }\n    reembolsos {\n        int id PK\n        int pagamento_id FK\n        int transacao_id FK\n        decimal valor\n        varchar motivo\n        varchar status\n        datetime solicitado_em\n        datetime concluido_em\n    }\n    notas_fiscais {\n        int id PK\n        int pedido_id FK\n        varchar numero\n        varchar serie\n        char chave_acesso\n        decimal valor_total\n        datetime emitida_em\n        varchar url_xml\n    }\n    transportadoras {\n        int id PK\n        varchar nome\n        char cnpj\n        varchar telefone\n        varchar email\n        boolean ativo\n    }\n    fretes {\n        int id PK\n        int pedido_id FK\n        int transportadora_id FK\n        varchar modalidade\n        int prazo_dias\n        decimal valor\n        varchar status\n        varchar codigo_cotacao\n    }\n    expedicoes {\n        int id PK\n        int pedido_id FK\n        int frete_id FK\n        int armazem_id FK\n        varchar status\n        varchar codigo_rastreio\n        datetime criada_em\n        datetime enviada_em\n        datetime entregue_em\n    }\n    itens_expedicao {\n        int id PK\n        int expedicao_id FK\n        int item_pedido_id FK\n        int quantidade\n    }\n    rastreamentos {\n        int id PK\n        int expedicao_id FK\n        varchar status\n        varchar descricao\n        varchar localizacao\n        datetime ocorrido_em\n    }\n    devolucoes {\n        int id PK\n        int pedido_id FK\n        int cliente_id FK\n        varchar motivo\n        varchar status\n        datetime solicitada_em\n        datetime concluida_em\n    }\n    itens_devolucao {\n        int id PK\n        int devolucao_id FK\n        int item_pedido_id FK\n        int quantidade\n        varchar condicao_item\n        varchar resolucao\n    }\n    listas_desejos {\n        int id PK\n        int cliente_id FK\n        varchar nome\n        boolean publica\n        datetime criada_em\n    }\n    itens_lista_desejos {\n        int id PK\n        int lista_id FK\n        int produto_id FK\n        datetime adicionado_em\n    }\n    campanhas {\n        int id PK\n        varchar nome\n        text descricao\n        datetime inicio_em\n        datetime fim_em\n        decimal percentual_desconto\n        boolean ativa\n    }\n    campanha_produtos {\n        int id PK\n        int campanha_id FK\n        int produto_id FK\n    }\n    tickets_suporte {\n        int id PK\n        int cliente_id FK\n        int pedido_id FK\n        varchar assunto\n        varchar status\n        varchar prioridade\n        datetime aberto_em\n        datetime encerrado_em\n    }\n    mensagens_suporte {\n        int id PK\n        int ticket_id FK\n        int cliente_id FK\n        int funcionario_id FK\n        text mensagem\n        datetime enviado_em\n    }\n    categorias ||--o{ subcategorias : \&quot;categoria_id\&quot;\n    subcategorias ||--o{ produtos : \&quot;subcategoria_id\&quot;\n    marcas ||--o{ produtos : \&quot;marca_id\&quot;\n    colecoes |o--o{ produtos : \&quot;colecao_id\&quot;\n    produtos ||--o{ variantes_produto : \&quot;produto_id\&quot;\n    produtos ||--o{ imagens_produto : \&quot;produto_id\&quot;\n    variantes_produto |o--o{ imagens_produto : \&quot;variante_id\&quot;\n    atributos |